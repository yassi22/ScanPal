# ────────────────────────────────────────────────────────────────
# ScanPal — apps/web env (Next.js)
# Kopieer naar .env en vul de waarden in.
# ────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000

# Threat-honeypots (plan 12): apart domein voor honeypot-URL's (bijv.
# honeypot.scanpal.app) zodat crawlers/verwijzingen naar het app-domein het
# signaal niet vervuilen. Default = APP_URL.
# HONEYPOT_BASE_URL=https://honeypot.scanpal.app

# Supabase Auth (Project Settings → API keys)
# URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Anon public key (client-side veilig)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
# Service role key (SERVER-ONLY! nooit in client code) — voor admin-API's (features 2/3)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Database (Project Settings → Database → Connection string → "Transaction pooler")
# Let op: URL-encode speciale tekens in het wachtwoord (%40 = @, %23 = #, %25 = %)
# Als je de Direct Connection gebruikt (poort 5432) i.p.v. pooler (6543):
# dan omzetten naar "postgresql://postgres.jldimgqvdybgatkumqto:WACHTWOORD@aws-0-EU-REGIO.pooler.supabase.com:6543/postgres"
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-EU-REGIO.pooler.supabase.com:6543/postgres

# Redis (rate limiting, plan 14): nodig voor API-key requests
REDIS_URL=redis://localhost:6379

# Email (magic links)
# Supabase verstuurt de magische links. Configureer Resend als SMTP-provider in het
# Supabase-dashboard: Project Settings → Auth → SMTP → "Custom SMTP"
# SMTP-host: smtp.resend.com · poort: 465 (SSL) · user: resend · pass: je Resend API key
# De onderstaande keys gebruik je pas zodra de webapp zelf e-mails verstuurt (feature 2: uitnodigingen).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ScanPal <no-reply@jouwdomein.nl>

# CrUX field data (plan 62): Chrome UX Report-API-key (Google, gratis).
# Zonder key draait de crux-field-data-check met een info-finding (geen
# score-straf). Maak een key aan op https://developers.google.com/chrome-ux-report
# Zie ook apps/worker/src/env.ts.
# CRUX_API_KEY=AIza...

# Threat intelligence / reputatie (plan 75). Alle bronnen zijn optioneel en
# worden zonder key als overgeslagen bron gerapporteerd; minstens één key is
# nodig voor een reputatie-oordeel. Let vóór commercieel productiegebruik op
# de ToS van de gekozen free tier (met name VirusTotal en Safe Browsing).
# SPAMHAUS_DQS_KEY=your-26-character-dqs-key
# ABUSECH_AUTH_KEY=your-abuse-ch-auth-key
# SAFE_BROWSING_API_KEY=AIza...
# VIRUSTOTAL_API_KEY=your-virustotal-api-key
# ABUSEIPDB_API_KEY=your-abuseipdb-api-key
# Cache-TTL in seconden; standaard 12 uur.
# THREAT_INTEL_CACHE_TTL_SECONDS=43200

# Scan-modus
# inline = webapp draait een kleine set checks (dev-stand-in tot de BullMQ/worker pipeline er is)
# queue  = webapp enqueue-t alleen; de worker moet draaien
SCAN_MODE=inline

# Scheduler (plan 05, apps/scheduler)
# Poll-interval voor geplande scans (dagelijks/wekelijks), standaard 60000
# POLL_INTERVAL_MS=60000

# Outbound webhooks (plan 15): 32-byte AES-256-GCM-sleutel (base64) waarmee
# webhook-secrets worden versleuteld. Zelfde waarde in apps/scheduler (daar
# verplicht voor de deliverer). Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WEBHOOK_SECRET_KEY=VGhpcy1pcy1hLXNlY3JldC1rZXktY2hhbmdlLW1l...

# Auth-flow scanner (plan 77): 32-byte AES-256-GCM-sleutel (base64) waarmee het
# wegwerp-testaccount per site wordt versleuteld. Zelfde waarde in apps/worker.
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_CREDENTIAL_KEY=VGhpcy1pcy1hLXNlY3JldC1rZXktY2hhbmdlLW1l...

# On-deploy triggers (plan 58): Vercel webhook-secret (x-vercel-signature
# verificatie). Zelfde waarde instellen in de Vercel-webhook configuratie.
# VERCEL_WEBHOOK_SECRET=vercel-webhook-secret

# ── Nog niet in gebruik (features 2/3) ──────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Stripe billing (plan 03)
# Testmode: maak keys aan op dashboard.stripe.com (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID van het Pro-abonnement (Products -> "Pro monthly" -> API ID, bijv. price_1xxx)
STRIPE_PRICE_PRO=price_...
# Price ID van het jaarlijkse Pro-abonnement (plan 16). Zet op de price:
# tax_behavior = exclusive (Stripe Tax rekent btw bovenop de prijs)
# STRIPE_PRICE_PRO_ANNUAL=price_...
# Price ID van het Max-abonnement (plan 64). Zet op de price:
# tax_behavior = exclusive (Stripe Tax rekent btw bovenop de prijs)
# STRIPE_PRICE_MAX=price_...
# STRIPE_PRICE_MAX_ANNUAL=price_...
# Publieke publishable key (client-side veilig; nog niet in de UI gebruikt)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
