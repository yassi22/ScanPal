      "html": "<span class=\"ds-status\" aria-label=\"Status: completed\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Completed</span>",
      "css": ".ds-status { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 6px 10px; color: #166534; background: #f0fdf4; font: 500 13px/17px 'Helvetica Neue', Helvetica, Arial, sans-serif; } .ds-status-dot { width: 7px; height: 7px; border-radius: 999px; background: #22c55e; } .ds-status:focus-visible { outline: 2px solid #3b82f6; outline-offset: 3px; }"
    }
