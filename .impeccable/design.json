  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Decisive black pill action for scanning or unlocking a report.",
      "html": "<button class=\"ds-btn-primary\">Scan my site</button>",
      "css": ".ds-btn-primary { background: #0a0a0a; color: #fff; border: 0; border-radius: 999px; padding: 12px 24px; font: 500 15px/22.5px 'Helvetica Neue', Helvetica, Arial, sans-serif; transition: background-color 150ms ease-out, transform 150ms ease-out, box-shadow 150ms ease-out; } .ds-btn-primary:hover { background: #1f1f1f; } .ds-btn-primary:focus-visible { outline: 2px solid #3b82f6; outline-offset: 3px; } .ds-btn-primary:active { transform: scale(0.98); }"
    },
    {
      "name": "Secondary Link",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet navigation or low-commitment action beside the primary pill.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#product\">Explore product</a>",
      "css": ".ds-btn-secondary { display: inline-flex; align-items: center; border-radius: 999px; padding: 8px 12px; color: rgba(10, 10, 10, 0.9); background: transparent; font: 500 15px/15px 'Helvetica Neue', Helvetica, Arial, sans-serif; text-decoration: none; transition: background-color 150ms ease-out, color 150ms ease-out; } .ds-btn-secondary:hover { background: rgba(10, 10, 10, 0.06); color: #1a1c21; } .ds-btn-secondary:focus-visible { outline: 2px solid #3b82f6; outline-offset: 3px; }"
    },
    {
      "name": "URL Scan Field",
      "kind": "input",
      "refersTo": "input-url",
      "description": "The hero focal control: a paper field with a compact embedded scan action.",
      "html": "<label class=\"ds-url-shell\"><span class=\"ds-url-label\">Your website address</span><input class=\"ds-url-input\" type=\"url\" placeholder=\"Enter your website address\" /><button class=\"ds-url-action\">Scan my site</button></label>",
      "css": ".ds-url-shell { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; background: #fff; border: 1px solid #e0e0e0; border-radius: 14px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06), 0 28px 64px -22px rgba(15, 23, 42, 0.28); transition: box-shadow 200ms ease-out; } .ds-url-shell:focus-within { box-shadow: 0 36px 90px -24px rgba(15, 23, 42, 0.24), 0 8px 24px -12px rgba(0, 0, 0, 0.12); } .ds-url-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .ds-url-input { min-width: 0; flex: 1; border: 0; outline: 0; padding: 12px 0; color: #1a1c21; background: transparent; font: 400 18px/28px 'Helvetica Neue', Helvetica, Arial, sans-serif; } .ds-url-input::placeholder { color: #86868a; } .ds-url-action { flex: 0 0 auto; border: 0; border-radius: 999px; padding: 12px 24px; color: #fff; background: #0a0a0a; font: 500 15px/22.5px 'Helvetica Neue', Helvetica, Arial, sans-serif; } .ds-url-action:hover { background: #1f1f1f; } .ds-url-action:focus-visible { outline: 2px solid #3b82f6; outline-offset: 3px; }"
    },
    {
      "name": "Light Card",
      "kind": "card",
      "refersTo": "card-light",
      "description": "Paper container for explanatory content, scan summaries and report sections.",
      "html": "<article class=\"ds-card-light\"><h3>Scan for issues</h3><p>Every check comes back ranked, with a fix.</p></article>",
      "css": ".ds-card-light { padding: 24px; color: #1a1c21; background: #fff; border: 1px solid #e0e0e0; border-radius: 14px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06); } .ds-card-light h3 { margin: 0; font: 500 20px/26px 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: -0.02em; } .ds-card-light p { margin: 8px 0 0; color: #86868a; font: 400 16px/24px 'Helvetica Neue', Helvetica, Arial, sans-serif; }"
    },
    {
      "name": "Diagnostic Panel",
      "kind": "custom",
      "refersTo": "card-dark",
      "description": "Dark contrast surface for code, technical evidence and product previews.",
      "html": "<section class=\"ds-diagnostic\"><code>Headers &amp; TLS</code><strong>Scan complete</strong></section>",
      "css": ".ds-diagnostic { display: grid; gap: 12px; padding: 24px; color: #fff; background: linear-gradient(#17171e 0%, #131318 100%); border-radius: 18px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 1px 2px rgba(4, 6, 14, 0.5), 0 32px 64px -32px rgba(4, 7, 18, 0.95); } .ds-diagnostic code { color: #c9d2e0; font: 500 13px/18px 'SF Mono', 'Fira Code', monospace; } .ds-diagnostic strong { font: 500 20px/26px 'Helvetica Neue', Helvetica, Arial, sans-serif; }"
    },
